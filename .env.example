# Connection string do PostgreSQL (deve apontar para o banco do docker-compose)
DATABASE_URL=postgresql+asyncpg://aiops:aiops123@localhost:5432/aiops_k8s

# Chave de API da Anthropic (obrigatorio quando usar agentes)
ANTHROPIC_API_KEY=sk-ant-...

# Endpoint HTTP do MCP Server Kubernetes (executado localmente via npx, transport streamable HTTP)
MCP_SERVER_URL=http://localhost:3001/mcp

# Intervalo do loop de coleta de eventos Warning do cluster, em minutos (padrao: 3; aceita fracoes, ex: 0.5)
EVENT_COLLECTION_INTERVAL_MINUTES=3

# Modelo Claude usado pelo agente de analise de causa raiz (padrao: claude-haiku-4-5)
AGENT_MODEL_NAME=claude-haiku-4-5

# Maximo de chamadas ao modelo por analise (padrao: 25)
AGENT_MAX_ITERATIONS=25

# Prazo total de uma analise, em minutos (padrao: 20; deve ser menor que ANALYSIS_STALE_TIMEOUT_MINUTES)
AGENT_TIMEOUT_MINUTES=20

# Maximo de analises simultaneas (padrao: 1)
ANALYSIS_MAX_CONCURRENCY=1

# Relatorio EM_ANALISE sem atualizacao ha mais que isso (minutos) e marcado INCOMPLETO (padrao: 30)
ANALYSIS_STALE_TIMEOUT_MINUTES=30
